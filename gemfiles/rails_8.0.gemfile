# frozen_string_literal: true
source "https://rubygems.org"

gemspec path: ".."

# Target ActiveSupport 8.0.5.1 (Rails 8.0.x); 8.1.3.1 also exists on RubyGems
gem "activesupport", "8.0.5.1"
gem "rake", ">= 13"
gem "minitest", "~> 5.0"
gem "mocha", "~> 1.9"
gem "logger"
gem "mutex_m"
gem "bigdecimal"
gem "matrix"
gem "ostruct"
